# Roomler self-hosted configuration.
#
#   cp .env.selfhost.example .env.selfhost
#
# Then fill in the four values marked REQUIRED. Everything else has a working
# default. Used only by docker-compose.selfhost.yml — the development stack
# reads .env.example instead.

# ── REQUIRED ──────────────────────────────────────────────────────────────────

# Signs every session token. Generate:  openssl rand -hex 32
# The server REFUSES to boot in `production` on the built-in default, which is
# deliberate — the default is published in this repository.
MESHHARBOR_JWT_SECRET=

# Shared secret for ephemeral TURN credentials. Generate: openssl rand -hex 32
# Must match the coturn service; the compose file wires both from this one value.
MESHHARBOR_TURN_SECRET=

# Datastore credentials. They never leave this stack.
#
# ⚠️ Use letters and digits only — `openssl rand -hex 24` is ideal. The Mongo
# password is interpolated into a connection URL, so `@`, `:`, `/`, `?` and `#`
# in it will break the URL, and the failure reads as an authentication error
# rather than as a quoting problem.
MONGO_ROOT_USERNAME=roomler
MONGO_ROOT_PASSWORD=
MINIO_ROOT_USER=roomler
MINIO_ROOT_PASSWORD=

# ── Reachability ──────────────────────────────────────────────────────────────

# The URL people actually type. Used for OAuth callbacks and the links in
# invitation and notification email, so a wrong value here produces invitations
# that lead nowhere.
MESHHARBOR_PUBLIC_URL=http://localhost:8080
MESHHARBOR_HTTP_PORT=8080

# The address browsers send conference RTP to. `127.0.0.1` works ONLY for calls
# made on this machine — set it to the host's LAN or public IP for anything
# else. This does not affect remote desktop, tunnels, SSH or the overlay mesh.
MESHHARBOR_ANNOUNCED_IP=127.0.0.1

# The public IP coturn advertises for relayed candidates. Leave as-is if you are
# not exposing TURN.
MESHHARBOR_PUBLIC_IP=127.0.0.1
MESHHARBOR_TURN_URL=turn:127.0.0.1:3478
MESHHARBOR_TURN_REALM=roomler.local

# ── Optional ──────────────────────────────────────────────────────────────────

MESHHARBOR_DB_NAME=roomler
MESHHARBOR_S3_BUCKET=roomler
MESHHARBOR_MEDIASOUP_WORKERS=2
MESHHARBOR_LOG=info

# Accounts are usable immediately, because no SMTP is configured out of the box
# and an account awaiting an activation email that can never arrive is an
# account nobody can use. Set to false once you have configured MESHHARBOR__EMAIL__*.
MESHHARBOR_AUTO_VERIFY=true

# `production` is correct for anything reachable from a network. `development`
# relaxes the JWT-secret refusal and the Secure flag on the session cookie —
# only for a local trial over plain http on this machine.
MESHHARBOR_ENVIRONMENT=production

# Pin a specific build instead of the locally built image, once one is published.
# A published image's PROFILE is in its tag: `<tag>` is the full product,
# `<tag>-collab` / `-remote` / `-mesh` / `-access` carry only those pillars
# (docs/self-hosting.md, "Choose a profile").
# MESHHARBOR_IMAGE=ghcr.io/gjovanov/roomler-ai:latest

# Profile for a SOURCE build (`up -d --build`): full | collab | remote | mesh |
# access. Ignored by a pulled image — its profile is the tag above.
MESHHARBOR_PROFILE=full
