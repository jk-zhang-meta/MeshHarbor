[Unit]
# FR-96 — the UPDATE HALF of a per-user install: `roomlerd update-helper`, as
# root, once per wake. The systemd twin of the macOS `com.roomler.update`
# LaunchDaemon (agents/roomlerd/packaging/macos/com.roomler.update.plist).
#
# Why it exists: a per-user daemon runs as the user, and writing /usr needs
# root, whichever format the host takes (the .deb or the tarball). So a
# per-user install could never update itself unattended (#2046). This unit is
# the missing root half of updating, and nothing else: no enrollment, no
# control channel, no device row. It resolves the PUBLIC release feed,
# verifies what it downloads against the pinned release key, installs, and
# exits.
#
# Woken by meshharbor-update.timer (boot, then every 6 h) and meshharbor-update.path
# (the wake file a per-user daemon touches). Shipped DISABLED: install.sh
# enables the timer and the path for a per-user install only. A system
# install's root daemon updates itself, and a host has one updater.
#
# The operator's opt-out is the macOS one: /etc/meshharbor/disable-auto-update.
# The helper itself honours it, so this unit needs no condition of its own.
Description=MeshHarbor update helper (root) — installs new releases for a per-user install
Documentation=https://www.itachi.fans/meshharbor
After=network-online.target
Wants=network-online.target

# No start limit. meshharbor-update.path's PathExists= is LEVEL-triggered, so a
# wake that lands during a run restarts the service the instant it ends.
# systemd's default start limit (5 starts in 10 s) is a CLIFF — measured on
# systemd 255, six touches of the wake file in 10 s left meshharbor-update.path
# `failed (unit-start-limit-hit)` until a reboot or `systemctl reset-failed`,
# and a single `mkdir` at the wake path did the same in ~2 s. A local user
# could wedge the updater that way. The helper spaces its own runs instead
# (updater.rs UPDATE_HELPER_MIN_GAP, 60 s), so this never fires in normal use;
# it is the belt that keeps the path unit alive under a hostile burst.
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/bin/meshharbord update-helper
Environment=RUST_LOG=info
# The helper sleeps up to 60 s (its run-spacing gate) and may then download for
# up to 10 min, so its start must not be read as a hang. A oneshot already
# defaults to no start timeout (measured: TimeoutStartUSec=infinity); set it so
# a drop-in DefaultTimeoutStartSec cannot change that. A wedged apt/dpkg is no
# worse here than on the in-process updater, which runs the same commands with
# no timeout.
TimeoutStartSec=infinity
# A helper that fails BEFORE its gate (a binary that will not exec — 203/EXEC —
# or a panic in startup) would otherwise re-trigger at job-queue speed and hit
# meshharbor-update.path's OWN trigger limit (200 in 2 s), which also fails the
# path unit until a reboot. In auto-restart the service is not inactive, so the
# path unit holds. A failed INSTALL retries once after 60 s, into the 5-min
# install cooldown, and stops. Allowed for oneshot (only always/on-success are
# refused). Measured on systemd 255: with this, an exec-failing helper leaves
# the path unit `active (waiting)` and auto-restarts; without it the path unit
# failed in ~2 s.
Restart=on-failure
RestartSec=60s
# ⚠️ Never PrivateTmp=: it would hide /var/tmp too, and the wake file could
# never be consumed — the path unit would re-trigger forever.
