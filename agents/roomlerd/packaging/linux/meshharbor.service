[Unit]
Description=MeshHarbor Daemon — keeps this device on your private MeshHarbor mesh network and available for secure remote control
Documentation=https://www.itachi.fans/meshharbor
# An interactive user session is required for scrap capture (XShm needs a
# display) and enigo input injection (both run on the user's X server).
# This is a systemd *user* unit, not a system unit, for that reason.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# RETIRED-NAME-ANCHOR(3): a "was X" line has to name X.
# P3d Slice B: the daemon binary is now `roomlerd` (was `roomler-agent`).
ExecStart=/usr/bin/meshharbord run
# `always`, not `on-failure`: a self-update exits 0 on purpose (the agent
# hands off to the installer and shuts down cleanly), and `on-failure`
# would leave the node stopped until the next login — a successful
# upgrade would read as the host going offline. Codes come from
# `watchdog.rs`: 2 = STALL (watchdog forced exit) MUST come back;
# 7 = AGENT_DELETED (row deleted / quarantined server-side) must NOT —
# restarting only hammers a server that already said no; 8 = ALREADY_RUNNING
# (another process holds the single-instance lock) must NOT either — this
# process is redundant by definition, and without the exception `always`
# restarts it every 5 s forever. Especially reachable for THIS unit: a
# per-user agent and the system `meshharbord.service` both target the same
# config on a desktop that enabled both.
Restart=always
RestartSec=5
RestartPreventExitStatus=7 8
# RETIRED-NAME-ANCHOR: `roomler_agent` is the pre-FR-21 tracing target. Kept
# alongside the new one so this unit reads correctly on a daemon from either
# side of the rename; agent-core::logging mirrors it for units already on disk.
Environment=RUST_LOG=roomlerd=info,warn

# Sandboxing — conservative defaults appropriate for a user unit.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
# RETIRED-NAME-ANCHOR(10): systemd must whitelist BOTH trees or it denies an upgraded
# host its own.
# P3d Slice B: the appdirs resolver (src/appdirs.rs) uses the NEW `roomler`
# app segment on fresh installs but keeps the OLD `roomler-agent` tree when a
# pre-rename host already has one. Whitelist BOTH so neither a fresh install
# nor an upgraded host is blocked by ProtectHome=read-only.
# RETIRED-NAME-ANCHOR: dropping the legacy pair makes systemd deny the daemon its own
# pre-rename tree mid-migration, under ProtectHome=read-only. See docs/fr/FR-21.
# ⚠️ The legacy pair carries `-` ("ignore when missing"): a path listed WITHOUT
# it that does not exist fails the whole unit with 226/NAMESPACE ("Failed to
# set up mount namespacing: <the legacy config folder>: No such file or
# directory") — measured on systemd 255 — and a host that never ran the
# pre-rename agent has neither folder, so the unit could not start there at
# all WHEREVER THE SANDBOX APPLIES. A user manager applies it only inside an
# unprivileged user namespace it may mount in. Where it cannot create one,
# systemd logs "Failed to set up user namespacing for unprivileged user,
# ignoring"; where it can but may not mount in it (default Ubuntu 24.04:
# AppArmor's unprivileged-userns restriction) it skips the mounts silently.
# Either way this unit then runs with NO sandbox at all, which is why a fresh
# 24.04 guest started it fine (field-verified: the daemon shared the
# session's mount namespace, no read-only /home). The NEW pair keeps
# no prefix on purpose: `roomlerd enroll` creates both (the config, and the
# log folder), and a unit started before enrolling should fail naming the
# missing folder rather than run with it read-only.
ReadWritePaths=%h/.config/meshharbor %h/.local/share/meshharbor -%h/.config/roomler-agent -%h/.local/share/roomler-agent
# FR-85 P2c — the recorder's default folder (`~/Videos/Roomler`). Everything
# else under home stays read-only: a folder chosen elsewhere is refused by the
# recorder's test write, which falls back and names why in the Recordings
# view. `-`: a host without ~/Videos must still start (see above). A
# localized Videos folder (XDG_VIDEOS_DIR=~/Vidéos, …) is not covered and
# falls back the same way.
ReadWritePaths=-%h/Videos
# #1997 — three more paths the daemon writes, each one denied wherever the
# sandbox applies. Measured on Fedora 44, whose user manager DOES apply it: the
# daemon could not start at all, and restarted every 5 s forever with
# "acquiring single-instance lock … Read-only file system (os error 30)".
#   * `%t`, the runtime dir: ProtectSystem=strict leaves /run read-only, and
#     /run/user/$UID with it. The single-instance lock (instance_lock.rs) and
#     the LocalAPI socket ($XDG_RUNTIME_DIR/meshharbor.sock) both live there.
#   * the state folder: the portal's restore token (~/.local/state/meshharbor,
#     capture/portal/screencast.rs TokenStore). Read-only, the token cannot be
#     renewed, so the person at the screen is asked again every session. A
#     ReadWritePaths entry binds only a folder that EXISTS when the sandbox is
#     built, so the `+` line (run outside the sandbox) creates it first, 0700
#     as TokenStore::save sets it. Its `-` matters as much: a folder that
#     cannot be made costs one prompt per session, never the daemon's start.
#     ⚠️ Not StateDirectory=: measured on systemd 255, it found
#     ~/.config/meshharbor, took that for its own pre-XDG-state location, and
#     symlinked ~/.local/state/meshharbor to it. Every enrolled host has that
#     folder, so the token would have moved into the config folder.
#     A custom XDG_STATE_HOME is not covered and costs that prompt per session.
#   * ~/Downloads, where incoming files land (files.rs default_download_dir).
#     `-` and the localized-name caveat as for ~/Videos.
ReadWritePaths=%t
ExecStartPre=-+/bin/mkdir -p -m 0700 %h/.local/state/meshharbor
ReadWritePaths=-%h/.local/state/meshharbor
ReadWritePaths=-%h/Downloads
# FR-96 P2a — /var/tmp, for ONE file: the wake the root update helper watches
# (`meshharbor-update.path`, PathExists=/var/tmp/meshharbor-update-check). On a host
# whose installer enabled that helper, this daemon installs nothing itself; a
# pushed update only touches the wake file. ProtectSystem=strict leaves /var/tmp
# read-only wherever this sandbox applies (Fedora's user manager — the very
# population #2046 froze), so without this line every push there would fail
# EROFS and wait for the helper's own 6 h timer. Only the directory can be
# granted: a ReadWritePaths entry binds what EXISTS when the sandbox is built,
# and the helper deletes the wake file each time it runs. Nothing is opened
# beyond what this account can do outside the sandbox — /var/tmp is world
# writable. `-`: a host without it still starts.
ReadWritePaths=-/var/tmp

[Install]
# Both targets (#2144). `PartOf=` above stops the daemon with the graphical
# session, so the session target has to START it again too: a user manager that
# outlives a logout (a lingering user, an SSH login still open) reached
# `default.target` long ago, and with `default.target` alone the daemon stayed
# down after the next login until a reboot. A daemon enabled before this line
# re-enables itself once at start (`service.rs`, `repair_session_wants`).
WantedBy=default.target graphical-session.target
