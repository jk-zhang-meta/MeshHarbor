[Desktop Entry]
Type=Application
Name=MeshHarbor
GenericName=Remote access companion
Comment=Start the MeshHarbor companion in the tray at login
Exec=/usr/bin/meshharbor-desktop --autostart
Icon=meshharbor-desktop
Terminal=false
Categories=Network;RemoteAccess;Utility;

# FR-84 D6 — installed as /etc/xdg/autostart/meshharbor-desktop.desktop, i.e.
# under the SAME file name as the launcher entry in /usr/share/applications:
# XDG autostart matches a per-user override to the system entry by file name,
# so the documented opt-out below keeps working.
#
# `--autostart` is the only difference from the launcher entry, and it is the
# point: a login start stays in the tray (the companion is this device's
# consent PROMPT surface — a device set to "Prompt on host" whose companion is
# not running cannot ask anybody), while a person opening MeshHarbor from the
# app menu gets the window. Until the person has been through the Welcome
# tour, a login start opens it.
#
# To opt out per user: the companion's Settings → "Start at login" writes
#   ~/.config/autostart/meshharbor-desktop.desktop   with   Hidden=true
# which is exactly what doing it by hand looks like:
#   mkdir -p ~/.config/autostart
#   cp /etc/xdg/autostart/meshharbor-desktop.desktop ~/.config/autostart/
#   echo 'Hidden=true' >> ~/.config/autostart/meshharbor-desktop.desktop
#
# Wait for a tray to exist before starting: on GNOME/KDE the app-indicator host
# comes up after the session bus, and a companion that raced it lands with no
# tray icon at all.
X-GNOME-Autostart-Phase=Applications
X-GNOME-Autostart-Delay=5
