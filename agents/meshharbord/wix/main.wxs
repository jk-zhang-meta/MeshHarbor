<?xml version="1.0" encoding="UTF-8"?>
<!-- RETIRED-NAME-ANCHOR-BEGIN
     Every retired name here is MSI identity or legacy cleanup: the
     meshharbor_agent_exe FileKey that CustomActions reference and upgrades key off,
     the inert meshharbor-agent.exe alias the deployed fleet still resolves, and the
     pre-P4b install folder this package vacates.
     INVARIANT: an MSI identifier that ships cannot be renamed without breaking
     upgrades from every installed version. docs/fr/FR-21
-->
<!--
  WiX v3 source for meshharbor-agent MSI.

  Build with `cargo wix -p meshharbord` which invokes candle + light
  against this file.

  Install scope: per-user (InstallScope="perUser"). No UAC prompt and no
  admin rights required. Files land under
  %LOCALAPPDATA%\Programs\MeshHarbor\ (P4b renamed the folder from
  meshharbor-agent; the cleanup-legacy-install CA sweeps the vacated dir on
  upgrade) and config / state stays under %APPDATA%\meshharbor-agent\
  (written by the `directories` crate at runtime — deliberately NOT
  renamed: machine_id derives from the config path).

  Autostart: registered automatically on every install + upgrade via the
  RegisterAutostart custom action below. The action shells out to
  `meshharbord service install` which writes a Schema 1.2 Task
  Scheduler XML with restart-on-failure + battery-defeat settings (see
  agents/meshharbord/src/service.rs::render_task_xml). Symmetric
  UnregisterAutostart hook runs `service uninstall` before the EXE is
  removed during uninstall. Both actions Return="ignore" so an
  individual machine where the existing task has a tightened ACL (rare
  Win11 quirk that bit us 2026-04-29) doesn't sink the whole MSI —
  operator can still recover via the manual schtasks delete + service
  install path documented in packaging/windows/README.txt.

  Why this works without UAC: perUser MSIs run in the user's token
  context. Custom actions with Execute="deferred" Impersonate="yes"
  (which is the default in perUser mode) inherit that token. schtasks
  /Create /XML /F against a non-elevated task succeeds for the user
  who owns it.

  Effort 2 note (Windows Service deployment mode, 0.1.58):
  This MSI does NOT auto-register the alternative SCM service.
  CreateService requires admin elevation, which conflicts with the
  perUser install scope. Operators who want the service-mode autostart
  (fleet / pre-logon scenarios) install the MSI normally, then run
  `meshharbord service install` with the `as-service` flag from an
  elevated shell. A future per-machine MSI flavour can revisit
  auto-registering the SCM service via a deferred non-impersonated
  custom action.
  (XML comment rule: no consecutive dashes, hence the awkward phrasing.)
-->
<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>
    <Product
        Id='*'
        Name='MeshHarbor Agent'
        UpgradeCode='1F2D7B1C-8B2F-4D2E-B1A3-6B1E2C7E4D91'
        Manufacturer='G ROX LTD'
        Language='1033'
        Codepage='1252'
        Version='$(var.Version)'>

        <Package
            Id='*'
            Keywords='Installer'
            Description='MeshHarbor Daemon — private mesh network + secure remote control'
            Manufacturer='G ROX LTD'
            InstallerVersion='450'
            Languages='1033'
            Compressed='yes'
            InstallScope='perUser'
            SummaryCodepage='1252' />

        <Icon Id='MeshHarborProductIcon' SourceFile='agents\meshharbord\wix\meshharbor.ico' />
        <Property Id='ARPPRODUCTICON' Value='MeshHarborProductIcon' />

        <MajorUpgrade
            Schedule='afterInstallInitialize'
            DowngradeErrorMessage='A newer version of [ProductName] is already installed. Setup will now exit.' />

        <!--
          rc.18: dropped the cross-flavour LaunchCondition refusal that
          previously blocked install over the OTHER flavour. The
          CleanupLegacyPerMachine custom action below now scrubs any
          stale perMachine artefacts (SCM service + service-log dir)
          before InstallFiles runs, so the operator can switch flavours
          freely.
        -->

        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes' />
        <Property Id='DiskPrompt' Value='MeshHarbor Agent Installation' />
        <!-- Script opt-in: register autostart only after firewall preparation
             succeeds. Unset by default, so direct MSI installs are unchanged. -->
        <Property Id='MESH_SKIP_AUTOSTART' Secure='yes' />

        <Directory Id='TARGETDIR' Name='SourceDir'>
            <!-- Per-user install under %LOCALAPPDATA%\Programs\MeshHarbor
                 (P4b: renamed from meshharbor-agent — the node-stack
                 unification's ONE install folder; UpgradeCode unchanged, so
                 MajorUpgrade still removes the old-folder product first).
                 ICE38 requires components in a user-profile directory to use
                 an HKCU registry value as their KeyPath (not a file). ICE64
                 requires a RemoveFolder entry for every user-profile dir. -->
            <Directory Id='LocalAppDataFolder'>
                <Directory Id='ProgramsFolder' Name='Programs'>
                    <Directory Id='APPLICATIONFOLDER' Name='MeshHarbor'>
                        <Component Id='AgentExe' Guid='3A8C9F21-4E7D-4A8E-9F3B-8D1C2E7F5A62'>
                            <RegistryValue
                                Root='HKCU'
                                Key='Software\MeshHarbor\Agent'
                                Name='installed_exe'
                                Type='integer'
                                Value='1'
                                KeyPath='yes' />
                            <!-- P3d Slice B: the daemon EXE is now `meshharbord.exe`.
                                 The File Id stays `meshharbor_agent_exe` so every
                                 <CustomAction FileKey='meshharbor_agent_exe'> below
                                 still resolves to THIS (the real daemon) file. The
                                 component Id + Guid are unchanged for stable
                                 component identity across upgrade. -->
                            <!-- RETIRED-NAME-ANCHOR(3): an MSI FileKey is installer IDENTITY; five
                                 CustomActions reference it and upgrades key off it, so it is frozen
                                 deliberately. docs/fr/FR-21 -->
                            <File
                                Id='meshharbor_agent_exe'
                                Name='meshharbord.exe'
                                DiskId='1'
                                Source='target\release\meshharbord.exe' />
                            <RemoveFolder
                                Id='RemoveAppFolder'
                                Directory='APPLICATIONFOLDER'
                                On='uninstall' />
                            <RemoveFolder
                                Id='RemoveProgramsFolder'
                                Directory='ProgramsFolder'
                                On='uninstall' />
                        </Component>
                        <!-- P3d Slice C (retired Slice B's alias): the inert
                             `meshharbor-agent.exe` copy (`AgentExeAlias`, GUID
                             568CA8FA…) is no longer shipped — the whole live
                             fleet crossed rc.194 (verified against prod agents
                             2026-07-22), and every in-tree consumer resolves
                             `meshharbord.exe` first with a code-level fallback
                             (tray `agent_exe_path`). MajorUpgrade removes the
                             stale alias file from upgraded installs. -->
                        <!-- P4b: the tunnel CLI ships INSIDE the daemon MSI
                             (node-stack unification Option A — the MSI is the
                             one updater for the whole stack; daemon installs
                             subsume the CLI). Same component also appends the
                             install dir to the USER PATH so `mh` works
                             in any new shell — parity with the standalone
                             tunnel wizard's PATH integration. PATH lives and
                             dies with the CLI file; Part='last' + implicit
                             Permanent='no' removes only our segment on
                             uninstall, and msiexec broadcasts
                             WM_SETTINGCHANGE itself. P3e lever D: the file is
                             now the ~150 KB meshharbor-cli-shim, which re-execs
                             `meshharbord cli` — the daemon owns the command
                             surface, so this MSI no longer carries a second
                             22.1 MiB copy of crates meshharbord already links.
                             Installed NAME is unchanged (mh.exe), so the
                             PATH entry, user muscle memory and the
                             installer-smoke payload asserts all still hold.
                             The workflow builds
                             target\release\meshharbor-shim.exe via
                             `cargo build -p meshharbor-cli-shim [dash][dash]release`
                             before cargo-wix runs. HKCU KeyPath like siblings
                             (ICE38, user-profile dir). -->
                        <Component Id='TunnelExe' Guid='17E45A00-7EB6-44E0-97DB-2A6DB2D79683'>
                            <RegistryValue
                                Root='HKCU'
                                Key='Software\MeshHarbor\Agent'
                                Name='installed_tunnel_cli'
                                Type='integer'
                                Value='1'
                                KeyPath='yes' />
                            <!-- RETIRED-NAME-ANCHOR(3): meshharbor_tunnel_cli_exe is installer IDENTITY;
                                 upgrades key off the FileKey, so it is frozen deliberately even though
                                 the crate is `meshharbor-cli` now. docs/fr/FR-21 -->
                            <File
                                Id='meshharbor_tunnel_cli_exe'
                                Name='mh.exe'
                                DiskId='1'
                                Source='target\release\meshharbor-shim.exe' />
                            <Environment
                                Id='TunnelPathEnvPerUser'
                                Name='PATH'
                                Value='[APPLICATIONFOLDER]'
                                Part='last'
                                Action='set'
                                System='no' />
                        </Component>
                        <Component Id='LicenseTxt' Guid='4B1D2E80-6F3C-4B2A-9E1D-7A2B3C4D5E6F'>
                            <RegistryValue
                                Root='HKCU'
                                Key='Software\MeshHarbor\Agent'
                                Name='installed_license'
                                Type='integer'
                                Value='1'
                                KeyPath='yes' />
                            <File
                                Id='license_txt'
                                Name='LICENSE.txt'
                                DiskId='1'
                                Source='LICENSE' />
                        </Component>
                        <Component Id='ReadmeTxt' Guid='5C2E3F91-7A4D-4C3B-AF2E-8B3C4D5E6F70'>
                            <RegistryValue
                                Root='HKCU'
                                Key='Software\MeshHarbor\Agent'
                                Name='installed_readme'
                                Type='integer'
                                Value='1'
                                KeyPath='yes' />
                            <File
                                Id='readme_txt'
                                Name='README.txt'
                                DiskId='1'
                                Source='agents\meshharbord\packaging\windows\README.txt' />
                        </Component>
                        <!-- Phase 3b: Wintun TUN driver DLL for the overlay-l3
                             WireGuard mesh. LoadLibrary'd at runtime from the
                             app dir; signed by WireGuard LLC; staged into
                             target\release by the workflow's wintun step (only
                             overlay-l3 builds have it — the release pipeline
                             does). HKCU registry KeyPath like the siblings. -->
                        <Component Id='WintunDll' Guid='7E4A5B13-9C6F-4D5E-BF21-9D8E7F6A5B40'>
                            <RegistryValue
                                Root='HKCU'
                                Key='Software\MeshHarbor\Agent'
                                Name='installed_wintun'
                                Type='integer'
                                Value='1'
                                KeyPath='yes' />
                            <File
                                Id='wintun_dll'
                                Name='wintun.dll'
                                DiskId='1'
                                Source='target\release\wintun.dll' />
                        </Component>
                        <!-- App-local Microsoft VC++ 2015-2022 x64 runtime
                             (only the DLLs our binaries actually import; the
                             full Microsoft.VC14x.CRT folder shipped through
                             rc.363 and carried 1.12 MiB of dead weight). The
                             import tables say msvcp140 + vcruntime140 +
                             vcruntime140_1 and nothing else: meshharbord.exe
                             imports all three, mh.exe imports
                             vcruntime140, meshharbor-desktop.exe imports no CRT
                             at all, and msvcp140.dll itself pulls only the two
                             vcruntime DLLs. concrt140, vccorlib140,
                             msvcp140_1, msvcp140_2, msvcp140_atomic_wait and
                             msvcp140_codecvt_ids are satellite DLLs that a
                             consuming binary imports DIRECTLY when it uses the
                             matching STL feature (std::atomic wait, codecvt
                             facet ids, ...); none of ours does. Re-verify
                             after adding a C++ dependency with:
                               dumpbin -dependents <exe> | findstr /i 140
                             and extend this component plus the workflow's
                             staging list together if a new name appears.
                             installer-smoke asserts the three by name. The
                             release
                             meshharbord.exe links the CRT dynamically (its C++
                             encoder objects; the vcpkg static-md policy keeps
                             /MD), so a fresh Windows box without any VC++
                             redistributable popped "vcruntime140_1.dll was
                             not found" on the first daemon run (field report
                             2026-07-28). The EXE dir is first in the DLL
                             search path, so shipping the DLLs here makes the
                             install self-contained for meshharbord.exe,
                             mh.exe AND the meshharbor-desktop companion
                             placed beside them. Staged into target\release by
                             the workflow's VC++ runtime step. One component
                             for the whole set (the DLLs ship and upgrade as a
                             unit); HKCU KeyPath like siblings (ICE38,
                             user-profile dir). -->
                        <Component Id='VcRedistCrt' Guid='F120B201-E45A-422D-80FE-A5C0B77AF8EC'>
                            <RegistryValue
                                Root='HKCU'
                                Key='Software\MeshHarbor\Agent'
                                Name='installed_vcredist_crt'
                                Type='integer'
                                Value='1'
                                KeyPath='yes' />
                            <File Id='crt_msvcp140' Name='msvcp140.dll' DiskId='1' Source='target\release\msvcp140.dll' />
                            <File Id='crt_vcruntime140' Name='vcruntime140.dll' DiskId='1' Source='target\release\vcruntime140.dll' />
                            <File Id='crt_vcruntime140_1' Name='vcruntime140_1.dll' DiskId='1' Source='target\release\vcruntime140_1.dll' />
                        </Component>
                    </Directory>
                </Directory>
            </Directory>

            <!-- Start Menu shortcut (already HKCU-keyed, already cleans up) -->
            <Directory Id='ProgramMenuFolder'>
                <Directory Id='ProgramMenuSubfolder' Name='MeshHarbor'>
                    <Component Id='ApplicationShortcut' Guid='6D3F4A02-8B5E-4D4C-B03F-9C4D5E6F7081'>
                        <Shortcut
                            Id='AgentShortcut'
                            Name='MeshHarbor Agent'
                            Description='MeshHarbor Daemon — private mesh network + secure remote control'
                            Target='[APPLICATIONFOLDER]meshharbord.exe'
                            Arguments='run'
                            WorkingDirectory='APPLICATIONFOLDER' />
                        <RemoveFolder Id='CleanupProgramMenuSubfolder' On='uninstall' />
                        <RegistryValue
                            Root='HKCU'
                            Key='Software\MeshHarbor\Agent'
                            Name='installed'
                            Type='integer'
                            Value='1'
                            KeyPath='yes' />
                    </Component>
                </Directory>
            </Directory>
        </Directory>

        <Feature
            Id='Complete'
            Title='MeshHarbor Agent'
            Description='MeshHarbor Daemon — keeps this device on your private MeshHarbor mesh network and available for secure remote control.'
            Display='expand'
            Level='1'
            ConfigurableDirectory='APPLICATIONFOLDER'
            AllowAdvertise='no'
            InstallDefault='local'
            Absent='disallow'>
            <ComponentRef Id='AgentExe' />
            <!-- P4b: tunnel CLI + user-PATH append. -->
            <ComponentRef Id='TunnelExe' />
            <ComponentRef Id='LicenseTxt' />
            <ComponentRef Id='ReadmeTxt' />
            <ComponentRef Id='WintunDll' />
            <ComponentRef Id='VcRedistCrt' />
            <ComponentRef Id='ApplicationShortcut' />
        </Feature>

        <Property Id='ARPHELPLINK' Value='https://meshharbor.itachi.fans/' />
        <Property Id='ARPURLINFOABOUT' Value='https://meshharbor.itachi.fans/' />

        <!--
          Postinstall hook: register the Scheduled Task auto-start
          immediately after the EXE lands on disk. Runs deferred +
          impersonated as the installing user (default for perUser
          MSIs) so the task is registered against their account.
          Return="ignore" so a registration failure (e.g. existing
          task with a tightened ACL) doesn't fail the install — the
          operator can recover with manual schtasks /Delete and
          re-run `service install`.
        -->
        <CustomAction
            Id='RegisterAutostart'
            FileKey='meshharbor_agent_exe'
            ExeCommand='service install'
            Execute='deferred'
            Impersonate='yes'
            Return='ignore' />

        <!--
          Symmetric uninstall hook: tear down the Scheduled Task
          BEFORE the EXE is removed from disk (the action shells
          out to the EXE itself, so it must still be present).
          Only fires during full uninstall (REMOVE="ALL"); a
          maintenance/repair leaves the task alone.
        -->
        <CustomAction
            Id='UnregisterAutostart'
            FileKey='meshharbor_agent_exe'
            ExeCommand='service uninstall'
            Execute='deferred'
            Impersonate='yes'
            Return='ignore' />

        <!-- Only installations that opted into rules require administrator
             approval here. MSI logs the action result; cancellation/failure
             must not prevent uninstall. Same-path rules can be cleaned later. -->
        <CustomAction
            Id='RemoveInstallFirewall'
            FileKey='meshharbor_agent_exe'
            ExeCommand='service remove-firewall --elevate'
            Execute='immediate'
            Return='ignore' />

        <!--
          rc.18: cross-flavour cleanup. When the operator installs the
          perUser MSI over a prior perMachine install, this CA shells
          out to the freshly-laid EXE to scrub the OTHER flavour's
          stale artefacts (SCM service, service-log dir under
          %PROGRAMDATA%). Runs Impersonated as the installing user;
          service control needs admin so this is best-effort: a
          non-admin user couldn't have had a live perMachine install
          anyway. Return="ignore" so a cleanup glitch doesn't sink
          the install (the on-disk EXE itself takes priority).
          Same-flavour invocations (perUser over perUser) exit 0 via
          the helper's fast-path.
        -->
        <CustomAction
            Id='CleanupLegacyPerMachine'
            FileKey='meshharbor_agent_exe'
            ExeCommand='cleanup-legacy-install --target-flavour perUser'
            Execute='deferred'
            Impersonate='yes'
            Return='ignore' />

        <InstallExecuteSequence>
            <!--
              Run RegisterAutostart on every fresh install, repair,
              and MajorUpgrade. Skip during full uninstall — there's
              nothing to register and the EXE is about to be deleted
              anyway. The condition leaves it active for upgrade
              installs (which are technically "REMOVE=ALL" of the
              old + install of the new, scheduled separately).
            -->
            <Custom Action='RegisterAutostart' After='InstallFiles'>
                NOT (REMOVE="ALL") AND NOT MESH_SKIP_AUTOSTART
            </Custom>
            <!--
              rc.18: scrub stale artefacts AFTER the new EXE lands
              (so we can shell out to it). NB both this and
              RegisterAutostart are After='InstallFiles'; WiX v3
              breaks the tie in DOCUMENT order, so RegisterAutostart
              actually runs FIRST (an earlier comment here claimed
              the opposite). Ordering is immaterial: the helper's
              CA-reachable step only sweeps the vacated pre-rename
              install dir (P4b), and its cross-flavour arms — which
              touch the other flavour's task/service namespace — are
              never reached from the CA (same-flavour fast path; see
              install_cleanup.rs module docs). Skip during uninstall.
            -->
            <Custom Action='CleanupLegacyPerMachine' After='InstallFiles'>
                NOT (REMOVE="ALL")
            </Custom>
            <!--
              Run UnregisterAutostart only during full uninstall,
              and BEFORE RemoveFiles so the EXE we shell out to is
              still on disk.
            -->
            <Custom Action='UnregisterAutostart' Before='RemoveFiles'>
                REMOVE="ALL"
            </Custom>
            <Custom Action='RemoveInstallFirewall' Before='UnregisterAutostart'>
                REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE
            </Custom>
        </InstallExecuteSequence>
    </Product>
</Wix>
<!-- RETIRED-NAME-ANCHOR-END -->
