<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent for the Roomler desktop companion (the menu-bar app), the macOS
  counterpart of meshharbor-desktop.exe on Windows. Installed to
  ~/Library/LaunchAgents/ by the .pkg's post-install script.

  A LaunchAgent, never a LaunchDaemon: this owns a menu-bar item and a webview,
  both of which need the user's GUI session. `LSUIElement` in the .app's
  Info.plist keeps it out of the Dock and the app switcher.

  It is a UI surface, not a service — it holds no session, injects no input, and
  captures nothing. The agent keeps working with this closed or killed; what is
  lost is the place that TELLS you the two macOS permissions are missing, which
  the OS itself never does.

  KeepAlive is deliberately ABSENT (unlike com.roomler.agent, which restarts on
  a non-zero exit). A user who quits their menu-bar app means it; relaunching it
  under them would be a bug, not resilience. It comes back at the next login via
  RunAtLoad.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.roomler.desktop</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Applications/Roomler.app/Contents/MacOS/meshharbor-desktop</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>ProcessType</key>
    <string>Interactive</string>

    <key>StandardOutPath</key>
    <string>/tmp/meshharbor-desktop.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/meshharbor-desktop.err.log</string>
</dict>
</plist>
