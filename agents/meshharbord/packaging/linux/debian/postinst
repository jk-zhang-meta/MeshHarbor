#!/bin/sh
# Reload systemd so a unit CHANGE shipped by this package takes effect on
# upgrade, and turn on the package's own update half (FR-96 P5).
#
# The units ship as plain cargo-deb assets rather than through its
# `systemd-units` integration, and that stays deliberate: enabling and
# starting a daemon is the operator's / installer's decision, not the
# package's. But an asset-only install has a sharp edge — systemd keeps
# enforcing its CACHED copy of a unit, so any edit to a `.service` file is
# inert until the next reboot or a manual `daemon-reload`.
#
# That bit rc.439. It added `RestartPreventExitStatus=7 8` so a redundant
# instance stops restart-looping, and on an upgraded host the file on disk
# had the exception while the running systemd did not — the fix looked
# shipped and did nothing. Verified on buildhost: before this script the package
# had no maintainer scripts at all, only .list and .md5sums.
#
# The DAEMON is never enabled, started, restarted or stopped here — neither
# `meshharbord.service` (system) nor `meshharbor.service` (per-user): a package
# upgrade is not permission to change what is running on the host, and
# restarting the daemon would fight the self-updater that invoked dpkg in the
# first place.
#
# FR-96 P5 — the one thing this script does turn on is the package's update
# half: `meshharbor-update.timer` and `meshharbor-update.path`, which wake the root
# one-shot `meshharbor-update.service`. A per-user daemon runs under its unit's
# NoNewPrivileges, so it can never install a release itself: pkexec and sudo
# are both refused. Without the helper, a per-user install made any way but
# install.sh (apt, the Software app, dpkg) never updates again. On a system
# install the helper steps aside (that root daemon installs its own updates),
# so enabling it everywhere keeps one updater per host. Enabled the Debian way,
# through deb-systemd-helper: on the first configure of a version that ships
# this, and never again over an administrator who disabled it. The opt-out
# stays /etc/meshharbor/disable-auto-update.
set -e

HELPER_UNITS="meshharbor-update.timer meshharbor-update.path"

if [ "$1" = configure ] || [ "$1" = abort-upgrade ] || [ "$1" = abort-deconfigure ] || [ "$1" = abort-remove ]; then
    if command -v deb-systemd-helper >/dev/null 2>&1; then
        for unit in $HELPER_UNITS; do
            # Only lifts the mask this package's postrm sets on removal.
            deb-systemd-helper unmask "$unit" >/dev/null 2>&1 || true
            # was-enabled answers yes when there is no state yet (the first
            # configure of a version that ships this), and no after an
            # administrator disabled the unit: then the state is refreshed only.
            if deb-systemd-helper --quiet was-enabled "$unit"; then
                deb-systemd-helper enable "$unit" >/dev/null 2>&1 || true
            else
                deb-systemd-helper update-state "$unit" >/dev/null 2>&1 || true
            fi
        done
    fi
fi

# Absent in containers / chroots / docker builds, where there is no systemd
# to talk to and `systemctl` would fail.
if [ -d /run/systemd/system ]; then
    # Never fatal: a failed reload must not leave the package unconfigured.
    systemctl daemon-reload >/dev/null 2>&1 || true
    if [ "$1" = configure ] && command -v deb-systemd-invoke >/dev/null 2>&1; then
        for unit in $HELPER_UNITS; do
            # The timer and the path only, and only where enabled; starting them
            # wakes nothing at once (the timer's first run is OnActiveSec later).
            if systemctl is-enabled --quiet "$unit" 2>/dev/null; then
                deb-systemd-invoke start "$unit" >/dev/null 2>&1 || true
            fi
        done
    fi
fi

# NOTE: the per-user unit (`meshharbor.service`, systemd --user) cannot be
# reloaded from here — there is no user bus to talk to at dpkg time. Those
# installs pick the change up on next login, or via an explicit
# `systemctl --user daemon-reload` (see README.Debian).

exit 0
