+        let first = seq == self.local_seq_no && self.rexmit_next <= seq;
+        if !first && self.pipe() + len > self.congestion_controller.inner().window() {
+            return None;
+        }
+        if self.pace_wait(now, len).is_some() {
+            return None;
+        }
+        Some((seq, len))
+    }
