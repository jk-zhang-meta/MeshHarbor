+    /// Forget what the cumulative ACK now covers.
+    fn sack_prune(&mut self) {
+        let una = self.local_seq_no;
+        let mut kept = [None; SACK_SCOREBOARD];
+        let mut n = 0;
+        for (l, r) in self.sacked.into_iter().flatten() {
+            if r > una {
+                kept[n] = Some((l.max(una), r));
+                n += 1;
+            }
+        }
+        self.sacked = kept;
+    }
