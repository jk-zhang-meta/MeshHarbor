+    /// first resend of a recovery (or after a partial ACK) is the segment at
+    /// `local_seq_no` and goes whatever the window (RFC 6675 step 4.3).
+    fn recovery_hole(&self, now: Instant, mss: usize) -> Option<(TcpSeqNumber, usize)> {
+        self.recovery_point?;
