+/// Cube root by Newton's method (`core` has no `cbrt`).
+fn cbrt(a: f64) -> f64 {
+    if a <= 0.0 {
+        return 0.0;
+    }
+    let mut x = if a > 1.0 { a / 3.0 } else { 1.0 };
+    for _ in 0..64 {
+        let next = (2.0 * x + a / (x * x)) / 3.0;
+        let step = if next > x { next - x } else { x - next };
+        if step <= 1e-9 * next {
+            return next;
+        }
+        x = next;
+    }
+    x
