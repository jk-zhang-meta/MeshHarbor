+        }
+        let total = self
+            .window_acked_chunks
+            .saturating_add(self.window_lost_chunks);
+        let loss_pct = self.window_lost_chunks.saturating_mul(100) / total.max(1);
+        self.last_window_loss_pct = loss_pct;
