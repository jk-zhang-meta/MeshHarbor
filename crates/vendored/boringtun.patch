+    /// Update the preshared key in-place for future handshakes while preserving
+    /// both `handshake.last_handshake_timestamp` (TAI64N anti-replay watermark)
+    /// and any currently established transport `sessions`.
+    pub fn set_preshared_key(&mut self, psk: Option<[u8; 32]>) {
+        let has_active_session = self.sessions.iter().any(Option::is_some);
+        if self.handshake.is_expired() || !has_active_session {
+            self.timers.clear();
+        } else {
+            self.timers.sync_current_time();
+        }
+        self.handshake.set_preshared_key(psk);
+    }
+
+    /// Return the currently configured preshared key, if any.
+    pub fn preshared_key(&self) -> Option<[u8; 32]> {
+        self.handshake.preshared_key()
+    }
+
+    /// Return `true` if the current transport session slot is populated.
+    pub fn has_current_session(&self) -> bool {
+        self.sessions[self.current % N_SESSIONS].is_some()
+    }
+
+    /// Return `true` if any outbound packets are queued awaiting a session.
+    pub fn has_queued_packets(&self) -> bool {
+        !self.packet_queue.is_empty()
+    }
+
+    /// Queue an outbound IP packet without initiating a WireGuard handshake.
+    pub fn queue_packet_only(&mut self, packet: &[u8]) {
+        self.queue_packet(packet);
+    }
+
+    /// Clear all active transport sessions, queued packets, timers, and
+    /// in-flight handshake state while preserving `handshake.last_handshake_timestamp`
+    /// (TAI64N anti-replay watermark) and `handshake.params.preshared_key`.
+    pub fn reset_sessions_preserving_replay_and_psk(&mut self) {
+        self.handshake.clear_in_flight();
+        for s in &mut self.sessions {
+            *s = None;
+        }
+        self.packet_queue.clear();
+        self.timers.clear();
+    }
