+        let mut old_reply = Message::new();
+        old_reply.build(&[
+            Box::new(BINDING_SUCCESS),
+            Box::new(transaction),
+            Box::new(MessageIntegrity::new_short_term_integrity(old_password)),
+            Box::new(FINGERPRINT),
+        ])?;
+        f.agent
+            .restart(
+                "fresh-generation".into(),
