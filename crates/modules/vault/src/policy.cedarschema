//
// The vault's Cedar schema (FR-90 P3-2, design §8.4). Every policy an
// organization writes is validated against it, strictly, before it is
// stored: a policy that names an attribute or an action this schema does
// not have is refused, never kept to do nothing.

namespace MeshHarbor {
  // A person in the organization, in one Group per meshharbor role they hold
  // (`owner`, `admin`, `member`, … and the organization's own).
  entity Group;
  entity User in [Group];

  // A role an agent session assumes at its start.
  entity Role;

  // An agent session, in the role it assumed. `playbook` names the playbook
  // it runs, when it runs one.
  entity Session in [Role] = {
    owner: User,
    playbook?: String,
  };

  // A secret's folders, one per path prefix, each in the one above it: the
  // secret `rrn:org:secret:prod/db/main` is in the folders
  // `rrn:org:secret:prod/db` and `rrn:org:secret:prod`. `path` is the
  // secret's path within its organization (`prod/db/main`).
  entity SecretFolder in [SecretFolder];
  // P3-4c — `exec_allow`: the programs, by bare name, a value of this secret
  // may be handed to in `exec` mode (a guardrail holds every exec to it).
  // P3-5a — `audiences`: where a value may be presented, which a guardrail
  // holds every `proxy` use to: the upstream the daemon authenticates to.
  entity Secret in [SecretFolder] = {
    path: String,
    kind: String,
    tags: Set<String>,
    exec_allow: Set<String>,
    audiences: Set<String>,
  };

  // The device a request is made on, as its row holds it: `os` is `linux`,
  // `macos` or `windows`; tags are lowercased.
  type Device = {
    os: String,
    tags: Set<String>,
    owner: User,
  };

  // P3-7 — a device a session's flow exits through, or (P3-8) its command
  // runs on, named by its id, as its row holds it: `os` and `tags` as for
  // `Device`, and its owner. A policy names nodes by their tags
  // (`resource.tags.contains("office")`), or one by its id.
  entity Node = {
    os: String,
    tags: Set<String>,
    owner: User,
  };

  // A person answered an approval card in the session's room.
  type Approval = {
    approver: User,
  };

  // Who may assume a role, and on which device.
  action "role:assume" appliesTo {
    principal: [User],
    resource: [Role],
    context: {
      device: Device,
    },
  };

  // P3-4b — a session listing or describing a secret: its name and rules,
  // never a value, from the device it runs on. Nothing implies it: an
  // organization lets a role list what it may use by permitting this too.
  action "secret:list" appliesTo {
    principal: [Session],
    resource: [Secret],
    context: {
      device: Device,
    },
  };

  // A session using a secret: in which mode, toward which audience, for how
  // long, on which device, and whether a person approved it.
  action "secret:use" appliesTo {
    principal: [Session],
    resource: [Secret],
    context: {
      mode: String,
      audience: String,
      ttl_s: Long,
      device: Device,
      approval?: Approval,
    },
  };

  // P3-9-1 — a PERSON using a secret through an endpoint their device serves
  // them (`mh connect`): always as a proxy, toward `audience`, the
  // upstream the endpoint signs in to, for `ttl_s`, from `device`, whose
  // owner the person is — its row says so, never the request. A person's own
  // action: `secret:use` is a session's, so no policy written for sessions
  // admits a person, and only a permit that names this action does.
  // `approval` is never given yet (decision 24): a policy that asks for one
  // is refused `approval_unavailable`, since a person has nobody to say yes.
  action "secret:connect" appliesTo {
    principal: [User],
    resource: [Secret],
    context: {
      audience: String,
      ttl_s: Long,
      device: Device,
      approval?: Approval,
    },
  };

  // P3-7 — a session opening a SOCKS5 listener on the device it runs on,
  // its flows exiting through `resource`: to whatever destination the
  // tunnel policies allow there. Nothing implies it.
  action "net:socks" appliesTo {
    principal: [Session],
    resource: [Node],
    context: {
      device: Device,
    },
  };

  // P3-7 — a session opening a forward to one destination through
  // `resource`.
  action "net:forward" appliesTo {
    principal: [Session],
    resource: [Node],
    context: {
      device: Device,
      host: String,
      port: Long,
    },
  };

  // P3-8 — a session running one command on `resource` over MeshHarbor SSH, as
  // `account`: the account that device's SSH policy maps (`daemon`,
  // `console_user` or `named`), read from its row, so an organization can
  // forbid a session the daemon's (SYSTEM or root). Never the device the
  // session runs on: no ticket names it. Nothing implies it.
  action "ssh:run" appliesTo {
    principal: [Session],
    resource: [Node],
    context: {
      device: Device,
      account: String,
    },
  };
}
