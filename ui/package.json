{
  "name": "roomler-ai-ui",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && bun docs/build.ts",
    "docs:build": "bun docs/build.ts",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "e2e": "playwright test --config=playwright.config.cjs",
    "e2e:ui": "playwright test --config=playwright.config.cjs --ui",
    "test:phone": "vite build && playwright test -c playwright.phone.config.ts"
  },
  "dependencies": {
    "@emoji-mart/data": "^1.2.1",
    "@mdi/font": "^7.4.47",
    "@serenity-kit/opaque": "1.1.0",
    "@tiptap/extension-image": "^3.29.2",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/extension-mention": "^3.29.2",
    "@tiptap/extension-placeholder": "^3.29.2",
    "@tiptap/extension-underline": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@tiptap/suggestion": "^3.29.2",
    "@tiptap/vue-3": "^3.29.2",
    "d3-array": "^3",
    "d3-geo": "3.1.1",
    "d3-scale": "^4",
    "d3-shape": "^3",
    "d3-time": "^3",
    "d3-time-format": "^4",
    "dompurify": "^3.4.14",
    "emoji-mart": "^5.6.0",
    "markdown-it": "^14.3.0",
    "mediasoup-client": "^3.21.0",
    "pinia": "^3.0.4",
    "tippy.js": "^6.3.7",
    "tiptap-markdown": "^0.9.0",
    "topojson-client": "3.1.0",
    "vue": "^3.5.40",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0",
    "vuedraggable": "4.1.0",
    "vuetify": "^3.13.0",
    "world-atlas": "2.0.2"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/d3-array": "^3",
    "@types/d3-geo": "3.1.0",
    "@types/d3-scale": "^4",
    "@types/d3-shape": "^3",
    "@types/d3-time": "^3",
    "@types/d3-time-format": "^4",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "25.2.1",
    "@types/topojson-client": "3.1.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^28.1.0",
    "sass": "^1.102.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.2.12"
  }
