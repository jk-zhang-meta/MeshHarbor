# relay-pop configuration — copy to /opt/relay-pop/pop.env and fill in.
# One file drives every template (provision.sh renders with envsubst).

# Region id — MUST match the `id` in the API's MESHHARBOR__RELAY__REGIONS entry.
REGION=us-east

# Public DNS names (A records -> this VPS's public IP, created BEFORE provisioning).
COTURN_HOST=coturn-us-east.roomler.ai
DERP_HOST=derp-us-east.roomler.ai

# This VPS's public IPv4. With a provider NAT (rare on the chosen providers),
# set PRIVATE_IP too and coturn gets `external-ip=PUBLIC/PRIVATE`.
PUBLIC_IP=203.0.113.10
PRIVATE_IP=

# coturn static-auth-secret — the SAME value as the API's
# MESHHARBOR__TURN__SHARED_SECRET (v1: one secret fleet-wide; a per-region
# secret goes in the region's JSON spec `shared_secret` field instead).
TURN_SHARED_SECRET=CHANGE-ME

# The DERP ticket PUBLIC key — printed by the API at startup as
# "derp ticket signer loaded — set DERP_TICKET_PUBLIC_KEY to this".
# base64 of the raw 32-byte Ed25519 public key. NEVER the private key.
DERP_TICKET_PUBLIC_KEY=CHANGE-ME

# Relay port range coturn allocates from (opened in the firewall).
TURN_MIN_PORT=49152
TURN_MAX_PORT=65535
