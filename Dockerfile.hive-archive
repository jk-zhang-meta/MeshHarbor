# FR-90 P2h-1 — the archive replica image (docs/hive.md §12 "P2h-1"; spec §3b,
# "The image").
#
# An archive replica holds copies of its organization's agent sessions for
# their retention, and serves a session's room when no other member is
# online. It runs no session itself. The ORG runs this image, on its own
# machines: a replica is a plaintext copy of everything the agent saw (design
# §4.4), so an archive MeshHarbor ran would hold every hosted org's transcripts.
#
#   docker run -d --name hive-archive --hostname hive-archive-1 \
#     --restart unless-stopped -v hive-archive:/data \
#     -e MESHHARBOR_SERVER=https://roomler.ai \
#     -e MESHHARBOR_ENROLL_TOKEN=<an ADMINISTRATOR's enrollment token> \
#     ghcr.io/gjovanov/roomler-ai/hive-archive:<tag>
#
# The first start enrolls (`meshharbord enroll --archive-replica`), and every
# later one runs from the config on the volume; the token is single use, and
# no later start needs it. An ADMINISTRATOR then designates the device an
# archive replica in the org's Hive policy before it holds anything.
#
# ⚠️ THE VOLUME IS THE DEVICE: it holds the config (the agent token, the
# WireGuard key) and the store (every session placed here, in plaintext).
# Whoever holds it can read those sessions and pose as the device.
# ⚠️ A FIXED hostname: the machine id hashes the hostname, the OS and the
# config path, so one container keeps its name across restarts (compose's
# `hostname:`, a StatefulSet's pod name), and two archive replicas of one org
# never share one.
# ⚠️ It updates by a NEW container on the same volume, never by itself: the
# enrollment writes `auto_update = false`.
# ⚠️ It is ON THE MESH, in the userspace stack (FR-90 P2k-4): a member that
# only DERP reaches is followed over DERP. The stack's SOCKS5 front is on
# 127.0.0.1:11080, the container's own loopback on a network of its own as
# above; under `--network host` it is the HOST's, and anything running there
# reaches the org's mesh as this device.

# --- Stage 1: the agent, with Hive and the userspace overlay only ---
FROM rust:1.95-bookworm AS builder
RUN apt-get update \
    && apt-get install -y --no-install-recommends cmake \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY . .
# No capture, no input, no TUN: `hive` holds the copies, `overlay-netstack` is
# the overlay without a TUN. `--locked` pins Cargo.lock.
RUN cargo build --release -p meshharbord --locked \
    --no-default-features \
    --features hive,overlay-netstack

# --- Stage 2: runtime ---
FROM debian:trixie-slim AS runtime
# ca-certificates for TLS to the server; libssl3 + libgcc-s1 for reqwest's
# native TLS and the binary itself.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        libssl3 \
        libgcc-s1 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /src/target/release/meshharbord /usr/local/bin/meshharbord
COPY scripts/hive-archive-entrypoint.sh /usr/local/bin/hive-archive-entrypoint.sh
# Not root: it runs no session as anyone, so it needs no account but its own.
# HOME is the volume, so the store (`$HOME/.local/share/…/hive`) and every
# file the daemon keeps live on it with the config.
RUN chmod 0755 /usr/local/bin/hive-archive-entrypoint.sh \
    && useradd --system --uid 10001 --user-group --home-dir /data \
        --shell /usr/sbin/nologin meshharbor \
    && mkdir -p /data \
    && chown meshharbor:meshharbor /data \
    && chmod 0700 /data
USER meshharbor
# MESHHARBORD_ARCHIVE_IMAGE: an archive replica enrolled before its posture
# joined the mesh (FR-90 P2k-4) joins it at its first start in this image.
ENV HOME=/data \
    MESHHARBOR_DATA=/data \
    MESHHARBORD_AUTO_UPDATE=0 \
    MESHHARBORD_ARCHIVE_IMAGE=1
VOLUME ["/data"]
ENTRYPOINT ["/usr/local/bin/hive-archive-entrypoint.sh"]
