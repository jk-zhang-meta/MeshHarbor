# MeshHarbor Configuration
# Copy to .env and fill in values

# Application
MESHHARBOR__APP__HOST=0.0.0.0
MESHHARBOR__APP__PORT=3000

# Database
MESHHARBOR__DATABASE__URL=mongodb://meshharbor:meshharbor_pass@localhost:27019/meshharbor?authSource=admin
MESHHARBOR__DATABASE__NAME=meshharbor

# JWT
MESHHARBOR__JWT__SECRET=change-me-in-production-use-a-long-random-string
# Access token: 1 week (604800s). Refresh: 30 days (2592000s).
MESHHARBOR__JWT__ACCESS_TOKEN_TTL_SECS=604800
MESHHARBOR__JWT__REFRESH_TOKEN_TTL_SECS=2592000
MESHHARBOR__JWT__ISSUER=meshharbor

# Redis
MESHHARBOR__REDIS__URL=redis://localhost:6379

# S3 / MinIO
MESHHARBOR__S3__ENDPOINT=http://localhost:9000
MESHHARBOR__S3__ACCESS_KEY=minioadmin
MESHHARBOR__S3__SECRET_KEY=minioadmin
MESHHARBOR__S3__BUCKET=meshharbor
MESHHARBOR__S3__REGION=us-east-1

# mediasoup
MESHHARBOR__MEDIASOUP__NUM_WORKERS=2
MESHHARBOR__MEDIASOUP__LISTEN_IP=0.0.0.0
MESHHARBOR__MEDIASOUP__ANNOUNCED_IP=127.0.0.1
MESHHARBOR__MEDIASOUP__RTC_MIN_PORT=40000
MESHHARBOR__MEDIASOUP__RTC_MAX_PORT=49999

# TURN server
MESHHARBOR__TURN__URL=turn:localhost:3478
MESHHARBOR__TURN__USERNAME=meshharbor
MESHHARBOR__TURN__PASSWORD=meshharbor_turn_pass
# Shared secret for ephemeral TURN credentials. Must match the value
# in `turnserver.conf` (`static-auth-secret`). Generate with:
#   openssl rand -hex 32
MESHHARBOR__TURN__SHARED_SECRET=CHANGE-ME-openssl-rand-hex-32
# Ephemeral TURN credential TTL in seconds (default 600).
# MESHHARBOR__TURN__TTL_SECS=600

# Multi-region relay PoPs (regional coturn + DERP). Disabled by default —
# every issuance path then uses the single-region MESHHARBOR__TURN__* config.
# MESHHARBOR__RELAY__REGIONS_ENABLED=false
# JSON array of region specs; `caps` fields absent = true. Regional PoPs
# disable only "tls_443_udp" (DTLS — their UDP/443 DNAT lands on the plain
# 3478 listener); udp/443 and turns:443/tcp are served (DNAT + SNI split).
# MESHHARBOR__RELAY__REGIONS=[{"id":"us-east","turn_url":"turn:coturn-us-east.meshharbor.itachi.fans:3478","derp_url":"wss://derp-us-east.meshharbor.itachi.fans/derp","caps":{"tls_443_udp":false}}]
# Ed25519 private key minting regional-DERP admission tickets (PoPs get only
# the derived PUBLIC key, logged at API startup). Generate:
#   openssl genpkey -algorithm ed25519 -outform DER | base64 -w0
# MESHHARBOR__RELAY__DERP_TICKET_PRIVATE_KEY=

# Claude API (for document recognition)

# OAuth Social Login
MESHHARBOR__OAUTH__BASE_URL=http://localhost:3000
MESHHARBOR__OAUTH__GOOGLE__CLIENT_ID=
MESHHARBOR__OAUTH__GOOGLE__CLIENT_SECRET=
MESHHARBOR__OAUTH__FACEBOOK__CLIENT_ID=
MESHHARBOR__OAUTH__FACEBOOK__CLIENT_SECRET=
MESHHARBOR__OAUTH__GITHUB__CLIENT_ID=
MESHHARBOR__OAUTH__GITHUB__CLIENT_SECRET=
MESHHARBOR__OAUTH__LINKEDIN__CLIENT_ID=
MESHHARBOR__OAUTH__LINKEDIN__CLIENT_SECRET=
MESHHARBOR__OAUTH__MICROSOFT__CLIENT_ID=
MESHHARBOR__OAUTH__MICROSOFT__CLIENT_SECRET=

# Stripe Billing
MESHHARBOR__STRIPE__SECRET_KEY=
MESHHARBOR__STRIPE__PUBLISHABLE_KEY=
MESHHARBOR__STRIPE__WEBHOOK_SECRET=
MESHHARBOR__STRIPE__PRICE_PRO=
MESHHARBOR__STRIPE__PRICE_BUSINESS=

# Observability / analytics (stats PR-1)
# Master gate for stats collection + rollups (default true).
MESHHARBOR__STATS__ENABLED=true
# Comma-separated USER OBJECTIDS (24-hex) granted the platform
# observability dashboards AND the FR-58 newsletter admin surface.
# Ids, not emails — OAuth links accounts by
# bare email, so an email allowlist would be takeover-escalatable.
# Resolve: db.users.find({email: {$in: [...]}}, {_id: 1})
MESHHARBOR__STATS__PLATFORM_ADMINS=

# Outbound mail (activation, invites, mentions, subscribe confirmations).
# SendGrid when API_KEY is set; else SMTP when HOST+PORT are set (the e2e
# Mailpit shape); neither ⇒ no mailer, sends are skipped/refused loudly.
MESHHARBOR__EMAIL__API_KEY=
MESHHARBOR__EMAIL__FROM_EMAIL=noreply@meshharbor.itachi.fans
MESHHARBOR__EMAIL__FROM_NAME=MeshHarbor
# MESHHARBOR__EMAIL__SMTP_HOST=
# MESHHARBOR__EMAIL__SMTP_PORT=1025

# FR-58 — the newsletter's own From identity (campaign reputation isolated
# from the transactional From). Both optional; unset falls back to
# MESHHARBOR__EMAIL__FROM_*. ⚠️ Needs SPF/DKIM on the domain before a real send.
# MESHHARBOR__NEWSLETTER__FROM_EMAIL=newsletter@meshharbor.itachi.fans
# MESHHARBOR__NEWSLETTER__FROM_NAME=MeshHarbor Field Notes
